# Copy to .env for local development; set the same keys in Vercel for production (docs/DEPLOY.md).
# Never commit .env. Every key is optional: without keys the app runs on one machine, with workspaces
# kept in the browser, cameras in other tabs, staff reports and offline AI templates.

# --- Workspaces and storage (Supabase, free plan) -------------------------------------------
# Browser (public, safe to expose): live channel for phones, cameras and sensors over the internet
# URL: Supabase, Project Settings, Data API, Project URL (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=
# The publishable key (sb_publishable_...) from Project Settings, API Keys; a legacy anon key also works
VITE_SUPABASE_ANON_KEY=
# Server only: the secret key (sb_secret_...) from Project Settings, API Keys; a legacy service_role key
# also works. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Server only: signs workspace sessions and derives channel names and sensor keys. At least 32 random
# characters, for example the output of: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
WORKSPACE_SECRET=

# --- AI (free tiers): Groq first, Gemini as fallback and first for photos ---------------------
# Gemini keys from AI Studio start with AQ. (newer) or AIza (older); both work.
GROQ_API_KEY=
# Leave the models empty to use the defaults (openai/gpt-oss-120b, gemini-flash-latest). Set
# GROQ_VISION_MODEL only to a Groq vision model; without it, photos go to Gemini.
GROQ_MODEL=
GROQ_VISION_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Each workspace can bring its own AI keys (Settings, Keys and AI). Set to off so workspaces never use the
# deployment's Groq and Gemini keys above, and your quota is never spent by customers.
DEPLOYMENT_AI_KEYS=

# --- Telegram alerts with a switch-off button, and the weekly digest ---------------------------
# Optional: each workspace can connect its own bot (Settings, Keys and AI, Telegram, Connect). This bot
# serves the workspaces that have none; they set their chat id in Setup (the bot answers /chatid).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# The site's public https address, e.g. https://<project>.vercel.app. Telegram's webhook for a workspace's
# bot points here. Leave empty to use the address the request came to.
PUBLIC_URL=
# Lets only Supabase pg_cron call /api/tick (every minute) and Vercel Cron call /api/digest, as
# "Authorization: Bearer ..."
CRON_SECRET=

# --- Command webhook (optional): switch-off commands POSTed to your control system ------------
# Signed with HMAC-SHA256; the body names the workspace (docs/INTEGRATIONS.md). A workspace's own webhook
# (Settings, Keys and AI) replaces this one for that workspace.
COMMAND_WEBHOOK_URL=
COMMAND_WEBHOOK_SECRET=
